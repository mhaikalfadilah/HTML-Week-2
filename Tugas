<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Nesting Lists</h2>
    <ol type="i">
        <li>Item 1</li>
        <ul type="circle">
            <li>Sub Item 1</li>
            <li>Sub Item 2</li>
            <ol type="a">
                <li>Sub Sub Item 1</li>
                <li>Sub Sub Item 2</li>
            </ol>
        </ul>
        <li>Item 2</li>
        <ol type="1">
            <li>Sub Item 1</li>
            <ul type="square">
                <li>Sub Sub Item 1</li>
                <li>Sub Sub Item 2</li>
            </ul>
            <li>Sub Item 2</li>
        </ol>
        <li>Item 3</li>
        
    </ol>
</body>
</html>